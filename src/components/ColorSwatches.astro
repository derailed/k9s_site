      "lightgoldenrodyellow",
      "cornsilk",
      "beige",
      "olive",
      "olivedrab",
      "darkolivegreen",
    ],
  },
  {
    label: "Greens",
    colors: [
      "green",
      "darkgreen",
      "forestgreen",
      "seagreen",
      "mediumseagreen",
      "darkseagreen",
      "lightgreen",
      "palegreen",
      "lime",
      "limegreen",
      "lawngreen",
      "chartreuse",
      "greenyellow",
      "yellowgreen",
      "springgreen",
      "mediumspringgreen",
      "honeydew",
      "mintcream",
